@model UserListResponseModel

@{
    ViewData["Title"] = "User";
    int count = 0;
}
<a href="/User/Create" class="btn btn-primary mb-3">Add User</a>
<table class="table">
    <thead>
        <tr>
            <th scope="col">No</th>
            <th scope="col">Username</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model.Users)
        {
            <tr>
                <td>
                    <a href="/User/Edit/@item.UserId" class="btn btn-warning btn-sm">Edit</a>
                    <a href="/User/Delete/@item.UserId" class="btn btn-danger btn-sm" 
                    onclick="return confirm('Are you sure you want to delete this user?');">Delete</a>
                </td>
                <th scope="row">@(++count)</th>
                <td>@item.Username</td>
      
            </tr>  
        }
    </tbody>
</table>